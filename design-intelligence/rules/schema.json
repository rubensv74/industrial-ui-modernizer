{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Industrial UI Modernizer source rules",
  "type": "object",
  "required": [
    "version",
    "rules"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "category",
          "severity",
          "extensions",
          "pattern",
          "message",
          "rationale",
          "suggestion"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^IUM-[A-Z]+-[0-9]{3}$"
          },
          "category": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "info",
              "warning",
              "error"
            ]
          },
          "extensions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "pattern": {
            "type": "string"
          },
          "flags": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "suggestion": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
